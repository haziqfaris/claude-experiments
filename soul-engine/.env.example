# Claude credentials for the Soul Protocol (or run `ant auth login` instead)
ANTHROPIC_API_KEY=
# Optional overrides
# SOUL_MODEL=claude-opus-5-5
# SOUL_EFFORT=low
# SOUL_PORT=7777
# SOUL_DAYS=30
# SOUL_DEMO=1
# Project inventory (INVENTORY button, /find in the terminal)
# Folders whose sub-folders are projects to scan, besides the ones Claude Code worked in (; or , separated)
# SOUL_INVENTORY_ROOTS=C:/Users/you/Dev
# Your own domains: addresses on them are shown in full; personal and client addresses are masked
# SOUL_OWN_DOMAINS=example.com
# Folders to leave out (a regular expression on the full path)
# SOUL_INVENTORY_EXCLUDE=archive|old-
